{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "gallery-hello",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    // Enable the Node.js API.
    "nodejs_compat",
    // Allow fetching public URLs from the app.
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "gallery-hello"
    }
  ],
  "images": {
    // Enable Next.js image optimization through Cloudflare Images.
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
