{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "galleryhello-com",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    // Enable the Node.js API.
    "nodejs_compat",
    // Allow fetching public URLs from the app.
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      // Stores the incremental cache, including the "composable" entries
      // written by `use cache`.
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "galleryhello-com-cache"
    }
  ],
  "images": {
    // Enable Next.js image optimization through Cloudflare Images.
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
